# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored -- never commit real keys.

# LLM providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Google / YouTube Data API
YOUTUBE_API_KEY=

# Outbound email (use an app-specific password, not your account password)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
OWNER_EMAIL=

# Default city/region used for weather and location-aware answers
DEFAULT_LOCATION=

# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
